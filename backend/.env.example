# Lexiq API on the existing server; configure deployment secrets outside Git.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://192.168.0.252:27017/lexiq_db
# Legacy MONGO_URI remains supported if MONGODB_URI is unset.
API_URL=http://192.168.0.252:5000
FRONTEND_ORIGIN=http://192.168.0.252:3000,http://192.168.0.252,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://192.168.0.252
CLIENT_URL=http://192.168.0.252
# The specified deployment uses HTTP; set true when the public API uses HTTPS.
COOKIE_SECURE=false
# Set 1 only when exactly one trusted reverse proxy sits in front of the API.
TRUST_PROXY=0
